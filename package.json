{
  "name": "arangodb-elasticsearch-sync",
  "version": "1.0.0",
  "description": "A robust data synchronization service that incrementally transfers data from ArangoDB to Elasticsearch, keeping indices up-to-date with real-time changes",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "arangodb",
    "elasticsearch", 
    "sync",
    "data-synchronization",
    "incremental-sync",
    "real-time",
    "database",
    "search",
    "etl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenIngenium/data_sync_service.git"
  },
  "homepage": "https://github.com/OpenIngenium/data_sync_service#readme",
  "bugs": {
    "url": "https://github.com/OpenIngenium/data_sync_service/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.6.0",
    "arangojs": "^8.2.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3"
  },
  "files": [
    "config/",
    "db/",
    "document/",
    "utils/",
    "index.js",
    "README.md",
    "LICENSE"
  ]
}
